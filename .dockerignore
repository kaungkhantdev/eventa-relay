# Build context for Dockerfile.dev. Dependencies are installed inside the image
# (Linux binaries), never copied from the host (macOS binaries), and nothing
# built on the host or secret goes into a layer.
.git
.github
node_modules
dist
build
*.tsbuildinfo

# Test output
coverage
.nyc_output

# Secrets: compose hands .env to the container at run time instead.
**/.env
**/.env.*

# Machine-local
*.log
logs
.DS_Store
.idea
.vscode
.temp
.tmp
