# DEVELOPMENT ONLY. Not a production image: it carries devDependencies, runs
# the TypeScript compiler in watch mode and is never pushed anywhere.
# Production images are separate work (eventa-infra).
#
# Built by the umbrella eventa/docker-compose.yml for the relay service. That
# compose bind-mounts the live source READ-ONLY over the snapshot copied in at
# the end, so an edit on the host recompiles here just as `pnpm dev` does on
# the host, and nothing in the container writes back into the checkout.

# Debian (glibc), not Alpine (musl): native packages ship prebuilt binaries per
# libc, and the glibc ones are what CI's Ubuntu runner proves.
FROM node:24-bookworm-slim

# pnpm via Corepack, which ships with Node 24. `corepack install` reads
# "packageManager" from package.json, so the image runs the pnpm this repo pins
# (and CI uses) without a second copy of the version to keep in step. It is
# fetched here, at build time, so the container never downloads it on start.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

# The container must never install dependencies by itself. Before
# `pnpm <script>`, pnpm 11 checks node_modules against the lockfile and by
# default runs `pnpm install` when they differ, which writes into the project
# directory: here that is the read-only checkout, so it fails half-way with a
# file-system error. `error` stops with ERR_PNPM_VERIFY_DEPS_BEFORE_RUN
# instead, which means: dependencies changed, rebuild this image.
ENV pnpm_config_verify_deps_before_run=error

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable pnpm && corepack install

# Installed the way CI installs: frozen lockfile and pnpm 11's strict
# build-script policy (no dangerouslyAllowAllBuilds), so a dependency whose
# install script pnpm-workspace.yaml has not approved fails the build with
# ERR_PNPM_IGNORED_BUILDS instead of leaving a half-built node_modules.
# The pnpm store lives in a BuildKit cache, not in the image, so a rebuild
# after a dependency change only downloads what is new.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir /pnpm/store

# A snapshot of the source, so the image also runs on its own. The umbrella
# compose mounts the live source over it. .dockerignore keeps out
# node_modules, dist and every .env file.
COPY . .

# No EXPOSE: the relay answers no requests.
CMD ["pnpm", "dev"]
