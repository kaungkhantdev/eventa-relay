NODE_ENV=development

# eventa-api owns this database; the relay only reads `outbox_events` and sets
# `published_at`. Same connection string as the API.
DATABASE_URL=postgres://eventa:eventa@localhost:5432/eventa

RABBITMQ_URL=amqp://eventa:eventa@localhost:5672
RABBITMQ_EXCHANGE=eventa.events

# How often to look for unpublished rows, and how many to take per pass.
OUTBOX_POLL_MS=1000
OUTBOX_BATCH=100

LOG_LEVEL=info
